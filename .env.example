# Postgres connection (Railway/Render/DO managed Postgres, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/integration_hub"

# Redis connection (used by BullMQ for job queues)
REDIS_URL="redis://localhost:6379"

# 32-byte key, base64-encoded, used to encrypt tenant credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_MASTER_KEY="REPLACE_WITH_GENERATED_KEY"

# AWS KMS envelope encryption for tenant credentials (recommended for
# production — see README "Credential encryption (KMS)"). Leave unset for
# local dev; CREDENTIALS_MASTER_KEY above is used as a fallback and is still
# required even when KMS is on, since it's what the migration script uses to
# read any rows encrypted before KMS was configured.
# KMS_KEY_ID="arn:aws:kms:us-east-1:123456789012:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="REPLACE"
# AWS_SECRET_ACCESS_KEY="REPLACE"

# Shared secret for platform-admin operations (creating tenants, issuing their
# first API key). Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY="REPLACE_WITH_GENERATED_ADMIN_KEY"

PORT=3000
LOG_LEVEL=info
NODE_ENV=development
