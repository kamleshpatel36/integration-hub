{
  "name": "integration-hub",
  "version": "0.1.0",
  "description": "Multi-tenant iPaaS-style integration middleware (NetSuite <-> external systems)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "worker": "tsx watch src/queue/worker.ts",
    "scheduler": "tsx watch src/queue/scheduler.ts",
    "backup-scheduler": "tsx watch src/queue/backupScheduler.ts",
    "migrate-credentials-to-kms": "tsx src/scripts/migrateCredentialsToKms.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1115.0",
    "@aws-sdk/client-s3": "^3.1115.0",
    "@prisma/client": "^5.20.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsep": "^1.4.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
